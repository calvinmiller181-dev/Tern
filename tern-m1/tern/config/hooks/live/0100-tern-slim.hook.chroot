#!/bin/sh
# Runs inside the chroot at build time (live-build "hooks/live").
set -e

# Fewer background timers in the live session (measure first, tune later).
for unit in apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer; do
	systemctl mask "$unit" >/dev/null 2>&1 || true
done

# Measurement unit only does anything when the kernel command line contains tern.measure=1.
systemctl enable tern-measure.service >/dev/null 2>&1 || echo "tern hook: could not enable tern-measure.service" >&2

chmod 0755 /etc/skel/.config/labwc/autostart /usr/local/bin/tern-measure-idle 2>/dev/null || true
